{
  "name": "leaflet.control.resizer",
  "version": "0.0.1",
  "description": "Control to resize a Leaflet map",
  "main": "L.Control.Resizer.js",
  "style": "L.Control.Resizer.css",
  "types": "L.Control.Resizer.d.ts",
  "license": "BSD-3-Clause",
  "scripts": {
    "debug": "http-server -c-1",
    "lint:js": "eslint .",
    "lint:ts": "eslint --config eslint.config-ts.mjs *.ts",
    "lint": "npm run lint:js && npm run lint:ts",
    "lint:fix": "npm run lint:js -- --fix",
    "spec:js": "mocha -r jsdom-global/register test/spec.js",
    "spec:ts": "tsc",
    "spec": "npm run spec:js && npm run spec:ts",
    "test": "npm run lint && npm run spec"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjimenezshaw/Leaflet.Control.Resizer.git"
  },
  "keywords": [
    "Leaflet",
    "map",
    "geo",
    "control",
    "resize"
  ],
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "chai": "^4.5.0",
    "eslint": "^9.37.0",
    "eslint-plugin-html": "^8.1.3",
    "http-server": "^14.1.1",
    "jsdom": "27.0.0",
    "jsdom-global": "3.0.2",
    "leaflet": "^1.9.4",
    "mocha": "^11.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "leaflet": "^1.0.3"
  },
  "author": "Javier Jimenez Shaw",
  "readmeFilename": "README.md"
}
