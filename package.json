{
  "name": "leaflet.control.resizer",
  "version": "0.0.1",
  "description": "Control to resize a Leaflet map",
  "main": "L.Control.Resizer.js",
  "style": "L.Control.Resizer.css",
  "types": "L.Control.Resizer.d.ts",
  "license": "BSD-3-Clause",
  "scripts": {
    "debug": "http-server -c-1",
    "lint:js": "eslint .",
    "lint:ts": "eslint --config eslint.config-ts.mjs *.ts",
    "lint": "pnpm run lint:js && pnpm run lint:ts",
    "lint:fix": "pnpm run lint:js --fix",
    "spec:js": "mocha -r jsdom-global/register test/spec.js",
    "spec:ts": "tsc",
    "spec": "pnpm run spec:js && pnpm run spec:ts",
    "test": "pnpm run lint && pnpm run spec"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjimenezshaw/Leaflet.Control.Resizer.git"
  },
  "keywords": [
    "Leaflet",
    "map",
    "geo",
    "control",
    "resize"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "chai": "^4.5.0",
    "eslint": "^9.39.1",
    "eslint-plugin-html": "^8.1.3",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "jsdom": "27.2.0",
    "jsdom-global": "3.0.2",
    "leaflet": "^1.9.4",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "peerDependencies": {
    "leaflet": "^1.0.3"
  },
  "author": "Javier Jimenez Shaw",
  "readmeFilename": "README.md"
}
